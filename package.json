{
  "name": "psdrive",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "One drive for every cloud. Pool unlimited Google Drive accounts and S3 buckets into a single, fast, self-hosted file manager.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --watch src/server.ts --dev",
