# ---------------------------------------------------------------------------
# PSDrive configuration. Every value is optional — the app boots with defaults.
# Copy to .env (docker compose picks it up automatically).
# ---------------------------------------------------------------------------

# Where the app listens
PORT=3000
HOST=0.0.0.0

# Public URL, used for links that leave the app (Google OAuth callback).
APP_URL=http://localhost:3000

# Database + file blobs live here. Back up this folder and you have everything.
DATA_DIR=./data

# Auto-generated on first boot and stored in DATA_DIR/secret.key if omitted.
# Set it explicitly if you run several instances against the same data.
# APP_SECRET=change-me-to-32-plus-random-characters

# Loads a ready-made demo workspace (demo@psdrive.local / demo1234).
# Turn this off for a private instance.
DEMO_MODE=true

# debug | info | warn | error
LOG_LEVEL=info

# Reject uploads larger than this (bytes). Default: 8 GiB.
# MAX_UPLOAD_BYTES=8589934592

# Google Drive OAuth app. You can also paste these into Settings → Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# Set to true when running behind a reverse proxy that sets X-Forwarded-*.
TRUST_PROXY=true
