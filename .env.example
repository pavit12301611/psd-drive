# ---------------------------------------------------------------------------
# PSDrive configuration. Every value is optional — the app boots with defaults
# and walks you through setup in the browser on first run.
# Copy to .env (docker compose picks it up automatically).
# ---------------------------------------------------------------------------

# Where the app listens
PORT=3000
HOST=0.0.0.0

# Public URL. Only used for links that leave the app (Google OAuth callback,
# share links). Behind a proxy, set this to the real https:// domain.
APP_URL=http://localhost:3000

# Database + file blobs live here. Back up this folder and you have everything.
DATA_DIR=./data

# Auto-generated on first boot and stored in DATA_DIR/secret.key if omitted.
# Set it explicitly if you run several instances against the same data.
# APP_SECRET=change-me-to-32-plus-random-characters

# Real Google Drive connection (recommended path: paste these in the setup
# wizard or in Settings → Google, which encrypts them at rest).
#   1. Google Cloud Console → enable the "Google Drive API"
#   2. OAuth consent screen → External (add yourself as a test user) or Internal
#   3. Credentials → OAuth client ID → Web application
#   4. Authorised redirect URI: <APP_URL>/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed when the redirect URI is not derived from the request.
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback
# Folder created inside each connected Drive that receives uploads.
# GOOGLE_APP_FOLDER=PSDrive

# Demo workspace (demo@psdrive.local / demo1234 + sample files).
# OFF by default: a real install starts empty and asks for your own account.
DEMO_MODE=false

# Allow people other than the first (owner) account to sign up.
# Set to false once you have created your account on a public server.
ALLOW_SIGNUP=true

# debug | info | warn | error
LOG_LEVEL=info

# Reject uploads larger than this (bytes). Default: 8 GiB.
# MAX_UPLOAD_BYTES=8589934592

# Set to true when running behind a reverse proxy that sets X-Forwarded-*.
TRUST_PROXY=true
